function extrairCookiesSharepoint(headers) {
  var setCookie = headers["Set-Cookie"] || headers["set-cookie"];
  if (!setCookie) return "";
  if (Array.isArray(setCookie)) {
    return setCookie.map(function(c) { return String(c).split(";")[0].trim(); }).join("; ");
  }
  var str = String(setCookie);
  // Divide por quebras de linha ou vírgulas de múltiplos cookies
  var parts = str.split(/,(?=s*[A-Za-z0-9_-]+=)/);
  return parts.map(function(p) { return p.split(";")[0].trim(); }).join("; ");
}


/**
 * Diagnóstico completo de todas as conexões públicas com OneDrive / SharePoint
 */
function executarDiagnosticoConexoes() {
  var diag = {
    timestamp: Utilities.formatDate(new Date(), "America/Sao_Paulo", "dd/MM/yyyy HH:mm:ss"),
    sefin: null,
    seintecCalls: null,
    inventarioPasta: null
  };

  // 1. SEFIN
  try {
    var sefinRes = sincronizarPlanilhaSefin();
    diag.sefin = { sucesso: sefinRes.sucesso, erro: sefinRes.erro || null, tamanho: sefinRes.tamanhoBytes || 0 };
  } catch (e1) {
    diag.sefin = { sucesso: false, erro: e1.toString() };
  }

  // 2. SEINTEC Chamados
  try {
    var callsRes = sincronizarPlanilhaSharepoint();
    diag.seintecCalls = { sucesso: callsRes.sucesso, erro: callsRes.erro || null, tamanho: callsRes.tamanhoBytes || 0 };
  } catch (e2) {
    diag.seintecCalls = { sucesso: false, erro: e2.toString() };
  }

  // 3. Inventário Pasta
  try {
    var invRes = sincronizarInventarioSharepoint();
    diag.inventarioPasta = { sucesso: invRes.sucesso, erro: invRes.erro || null, totalArquivos: invRes.totalArquivos || 0 };
  } catch (e3) {
    diag.inventarioPasta = { sucesso: false, erro: e3.toString() };
  }

  return diag;
}
