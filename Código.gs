/**
 * Sincroniza eventos de arquivo iCal (.ics) do Carro Oficial sem salvar arquivos no Google Drive
 */
function sincronizarCarroIcal(url) {
  if (!url) return { sucesso: false, erro: "URL do calendário não fornecida." };
  try {
    var response = UrlFetchApp.fetch(url, {
      muteHttpExceptions: true,
      headers: { "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)" }
    });
    if (response.getResponseCode() === 200) {
      var icsText = response.getContentText();
      var eventos = parseIcsCarro(icsText);
      return {
        sucesso: true,
        eventos: eventos,
        total: eventos.length,
        timestamp: Utilities.formatDate(new Date(), "America/Sao_Paulo", "HH:mm")
      };
    } else {
      return { sucesso: false, erro: "Status HTTP " + response.getResponseCode() };
    }
  } catch (err) {
    return { sucesso: false, erro: err.toString() };
  }
}

/**
 * Parser de formato iCal (VEVENT) para extrair agendamentos de veículos
 */
function parseIcsCarro(icsContent) {
  var eventos = [];
  if (!icsContent) return eventos;
  
  var linhas = icsContent.replace(/\r\n /g, "").split(/\r\n|\n|\r/);
  var eventoAtual = null;
  
  for (var i = 0; i < linhas.length; i++) {
    var linha = linhas[i].trim();
    if (linha === "BEGIN:VEVENT") {
      eventoAtual = {
        id: "car-ics-" + (eventos.length + 1),
        titulo: "Reserva de Carro Oficial",
        data: "",
        horarioSaida: "08:00",
        horarioRetorno: "17:00",
        destino: "",
        veiculo: "Veículo Oficial",
        motorista: "Condutor Designado",
        solicitante: "Gabinete / URE",
        setor: "Gabinete",
        status: "Agendado",
        origemFonte: "Calendário Compartilhado",
        badgeOrigem: "Calendário Online",
        observacoes: ""
      };
    } else if (linha === "END:VEVENT" && eventoAtual) {
      if (eventoAtual.data) {
        eventos.push(eventoAtual);
      }
      eventoAtual = null;
    } else if (eventoAtual) {
      if (linha.indexOf("SUMMARY:") === 0) {
        eventoAtual.titulo = linha.substring(8);
      } else if (linha.indexOf("LOCATION:") === 0) {
        eventoAtual.destino = linha.substring(9);
      } else if (linha.indexOf("DESCRIPTION:") === 0) {
        eventoAtual.observacoes = linha.substring(12).replace(/\\n/g, "\n");
      } else if (linha.indexOf("DTSTART") === 0) {
        var val = linha.split(":")[1] || "";
        if (val.length >= 8) {
          var ano = val.substring(0, 4);
          var mes = val.substring(4, 6);
          var dia = val.substring(6, 8);
          eventoAtual.data = ano + "-" + mes + "-" + dia;
        }
        if (val.indexOf("T") !== -1) {
          var tPart = val.split("T")[1] || "";
          if (tPart.length >= 4) {
            eventoAtual.horarioSaida = tPart.substring(0, 2) + ":" + tPart.substring(2, 4);
          }
        }
      } else if (linha.indexOf("DTEND") === 0) {
        var valEnd = linha.split(":")[1] || "";
        if (valEnd.indexOf("T") !== -1) {
          var tEnd = valEnd.split("T")[1] || "";
          if (tEnd.length >= 4) {
            eventoAtual.horarioRetorno = tEnd.substring(0, 2) + ":" + tEnd.substring(2, 4);
          }
        }
      }
    }
  }
  return eventos;
}

